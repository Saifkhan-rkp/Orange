<div class="four wide column">
    <div class="ui vertical pointing secondary fluid menu hoverEdit">
        <% const menuItems = [
            { path: 'info', icon: 'info grey', label: 'Info' },
            { path: 'gps', icon: 'map marker alternate grey', label: 'GPS' },
            { path: 'microphone', icon: 'microphone grey', label: 'Microphone' },
            { path: 'screenshot', icon: 'camera grey', label: 'Screenshot' },
            { path: 'contacts', icon: 'address book grey', label: 'Contacts' },
            { path: 'calls', icon: 'phone grey', label: 'Call Log' },
            { path: 'clipboard', icon: 'clipboard grey', label: 'Clipboard Log' },
            { path: 'notifications', icon: 'exclamation grey', label: 'Notification Log' },
            { path: 'sms', icon: 'comments grey', label: 'SMS Manager' },
            { path: 'wifi', icon: 'wifi grey', label: 'WiFi Manager' },
            { path: 'apps', icon: 'google play grey', label: 'Installed Apps' },
            { path: 'permissions', icon: 'tasks grey', label: 'Allowed Permissions' },
            { path: 'files', icon: 'folder open grey', label: 'File Explorer' },
            { path: 'downloads', icon: 'download grey', label: 'Downloads' }
        ]; %>

        <% menuItems.forEach(function(item) { %>
            <a href="<%= baseURL %>/<%= item.path %>" class="item<%= page === item.path ? ' active' : '' %>">
                <i class="icon <%= item.icon %>"></i> <%= item.label %>
            </a>
        <% }); %>
    </div>
</div>